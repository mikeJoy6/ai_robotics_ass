<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="A2D_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>genie_hardware/GenieArmHardware</plugin>
                <param name="left_state_topic">/hal/left_arm_data</param>
                <param name="right_state_topic">/hal/right_arm_data</param>
                <param name="neck_state_topic">/hal/neck_state</param>
                <param name="body_state_topic">/hal/waist_state</param>
                <param name="left_ee_state_topic">/hal/left_ee_data</param>
                <param name="right_ee_state_topic">/hal/right_ee_data</param>
                
                
                
                <param name="command_topic">/wbc/arm_command</param>
                <param name="head_command_topic">/wbc/head_command</param>
                <param name="body_command_topic">/wbc/waist_command</param>
                <!-- 头部开关(见 A2D.urdf.xacro 的 control_head arg)：false 时 write() 不发头命令，脖子交给外部 PID。 -->
                <param name="control_head">$(arg control_head)</param>
                
                <param name="left_ee_command_topic">/wbc/left_ee_command</param>
                <param name="right_ee_command_topic">/wbc/right_ee_command</param>
                
                
                
            </hardware>
            <joint name="Joint1_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint1_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint2_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint2_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint3_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint3_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint4_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint4_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint5_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint5_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint6_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint6_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint7_l">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint7_l']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint1_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint1_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint2_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint2_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint3_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint3_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint4_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint4_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint5_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint5_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint6_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint6_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Joint7_r">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Joint7_r']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_head_yaw">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_head_yaw']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_head_pitch">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_head_pitch']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_lift_body">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_lift_body']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_body_pitch">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_body_pitch']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_narrow2_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_narrow2_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_narrow2_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_narrow2_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
