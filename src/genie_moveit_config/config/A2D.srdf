    <!-- ============ 手部相机碰撞体（DEVLOG「改urdf并添加碰撞体积」）============
         URDF 里新加了 hand_{left,right}_color_optical_frame 两个 link，各带一个 4.7×4.7×2.5cm
         的方盒代表相机模组。加进碰撞检测的【目的】是防止胳膊拿相机去撞【环境】(桌面 box、物品)
         和【另一条胳膊/头】——那些 pair 一律【保持开启】，不在下面禁用。

         下面禁用的只有"同一只手内部"的 pair：相机刚性固定在手掌上，跟本手的 link 之间【不存在
         相对运动】(Link7/base_link 与相机完全同步)，或虽有相对运动但几何上够不着(手指在
         y=±0.0217，盒心在 y=-0.0874，侧向让开 8.7cm；且盒心在指根 z=0.0739 后方 5.9cm)。
         不禁用的话它们会被判成"永远碰撞"，规划直接全废。
         Link6 故意【不禁用】：Joint7 转动时相机绕腕扫过，最近也有 9cm 余量，留着当真实检查。 -->
    <disable_collisions link1="hand_left_color_optical_frame"  link2="Link7_l"            reason="Adjacent"/>
    <disable_collisions link1="hand_left_color_optical_frame"  link2="left_base_link"     reason="Adjacent"/>
    <disable_collisions link1="hand_left_color_optical_frame"  link2="left_narrow2_Link"  reason="Never"/>
    <disable_collisions link1="hand_left_color_optical_frame"  link2="left_narrow4_Link"  reason="Never"/>
    <disable_collisions link1="hand_left_color_optical_frame"  link2="left_wide2_Link"    reason="Never"/>
    <disable_collisions link1="hand_left_color_optical_frame"  link2="left_wide4_Link"    reason="Never"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="Link7_r"            reason="Adjacent"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="right_base_link"    reason="Adjacent"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="right_narrow2_Link" reason="Never"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="right_narrow4_Link" reason="Never"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="right_wide2_Link"   reason="Never"/>
    <disable_collisions link1="hand_right_color_optical_frame" link2="right_wide4_Link"   reason="Never"/>
</robot>